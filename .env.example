# ============================================================
# Root environment variables for Docker Compose local development
# ============================================================

# Shared internal security key between backend and AI service
INTERNAL_API_KEY=replace_with_local_secret

# AI Service
GROQ_API_KEY=replace_with_groq_key

# Supabase database and authentication (Hosted Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_ANON_KEY=replace_with_anon_key
DATABASE_URL=postgresql://postgres:password@db.example.com:6543/postgres

# Frontend URL allowed by backend CORS
FRONTEND_URL=http://localhost:5173
